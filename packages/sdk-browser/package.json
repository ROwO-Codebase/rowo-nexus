{
  "name": "@nexus/sdk-browser",
  "version": "0.1.0",
  "description": "Strict browser popup transport for requesting Nexus ownership proofs.",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. packages/sdk-browser"
  },
  "dependencies": {
    "@nexus/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
