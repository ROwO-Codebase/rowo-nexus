{
  "name": "@nexus/edge-api-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public, cookie-free ROwO Nexus protocol API gateway.",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@nexus/cloudflare-common": "workspace:*",
    "@nexus/crypto": "workspace:*",
    "@nexus/protocol": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.120.1"
  }
}
