# Local development. `pnpm dev:rp` serves the RP with Vite's test-only self-signed
# certificate. Visit https://127.0.0.1:4174 once and accept the browser warning.
# Never trust or reuse this generated certificate outside local development.
# The browser SDK permits this loopback HTTP wallet URL only in Vite development builds.
VITE_NEXUS_WALLET_URL=http://127.0.0.1:5173
NEXUS_RP_ORIGIN=https://127.0.0.1:4174
NEXUS_API_URL=https://127.0.0.1:8787

# Optional isolated UI mode. Never enable this in a deployment; it replaces the
# authoritative registry lifecycle check with an in-memory local authority.
# NEXUS_LOCAL_LIFECYCLE_MODE=unsafe-local-test

# Production example:
# VITE_NEXUS_WALLET_URL=https://wallet.rowo.link
# NEXUS_RP_ORIGIN=https://notes.rowo.link
# NEXUS_API_URL=https://nexus.rowo.link
