# Local development only. Copy to an ignored local file if a package requires it.
# Production values belong in Cloudflare bindings/secrets, not .env files.
NEXUS_ENV=local
NEXUS_WALLET_ORIGIN=http://localhost:5173
NEXUS_API_ORIGIN=http://localhost:8787
NEXUS_STATUS_ORIGIN=http://localhost:8788

# Optional local-only anti-abuse fixtures. Never persist a Turnstile token with a subject.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Intentionally blank. Generate non-production local keys through the reviewed tooling.
# Receipt, status, and transparency keys are separate in every environment.
RECEIPT_SIGNING_PRIVATE_KEY=
RECEIPT_SIGNING_KID=
STATUS_SIGNING_PRIVATE_KEY=
STATUS_SIGNING_KID=
SERVICE_JWKS_JSON=
TRANSPARENCY_SIGNING_KEY_PKCS8_B64URL=
TRANSPARENCY_SIGNING_KID=
TRANSPARENCY_PUBLIC_KEYSET_JSON=
